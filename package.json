{
  "name": "gtea-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gtea": "dist/main.js"
  },
  "scripts": {
    "build": "bunx tsc -p tsconfig.json",
    "build:binary": "bun build --compile src/main.ts --outfile dist/bin/gtea",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "cli": "bun run src/main.ts",
    "test": "bun test tests/*.test.ts",
    "typecheck": "bunx tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.31",
    "typescript": "^5.8.3"
  }
}
