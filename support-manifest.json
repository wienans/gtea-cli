{
  "cliName": "gtea",
  "summary": "Gitea CLI compatible with GitHub CLI",
  "milestone": "Broad-First Milestone",
  "supportBaseline": "1.25.x",
  "flagProfiles": {
    "repositoryTarget": [
      {
        "name": "--repo",
        "aliases": [
          "-R"
        ],
        "summary": "Select the Repository Context explicitly",
        "status": "unsupported"
      }
    ],
    "issueRepositoryTarget": [
      {
        "name": "--repo",
        "aliases": [
          "-R"
        ],
        "summary": "Select the Repository Context explicitly",
        "status": "supported"
      }
    ],
    "prRepositoryTarget": [
      {
        "name": "--repo",
        "aliases": [
          "-R"
        ],
        "summary": "Select the Repository Context explicitly",
        "status": "supported"
      }
    ],
    "structuredOutput": [
      {
        "name": "--json",
        "summary": "Format output as JSON",
        "status": "unsupported"
      },
      {
        "name": "--jq",
        "summary": "Filter JSON output with jq syntax",
        "status": "emulated",
        "reason": "Implements the repository read slice's supported jq field-path subset.",
        "requires": [
          "--json"
        ]
      },
      {
        "name": "--template",
        "summary": "Format JSON output with a Go template",
        "status": "emulated",
        "reason": "Implements the repository read slice's supported field-interpolation template subset.",
        "requires": [
          "--json"
        ]
      }
    ],
    "issueStructuredOutput": [
      {
        "name": "--json",
        "summary": "Format output as JSON",
        "status": "supported"
      },
      {
        "name": "--jq",
        "summary": "Filter JSON output with jq syntax",
        "status": "emulated",
        "reason": "Implements the issue read slice's supported jq field-path subset.",
        "requires": [
          "--json"
        ]
      },
      {
        "name": "--template",
        "summary": "Format JSON output with a Go template",
        "status": "emulated",
        "reason": "Implements the issue read slice's supported field-interpolation template subset.",
        "requires": [
          "--json"
        ]
      }
    ],
    "issueListOptions": [
      {
        "name": "--app",
        "summary": "Filter by GitHub App author",
        "status": "unsupported",
        "reason": "Gitea repository issue lists do not expose a GitHub App author filter."
      },
      {
        "name": "--assignee",
        "aliases": [
          "-a"
        ],
        "summary": "Filter by assignee",
        "status": "supported"
      },
      {
        "name": "--author",
        "aliases": [
          "-A"
        ],
        "summary": "Filter by author",
        "status": "supported"
      },
      {
        "name": "--label",
        "aliases": [
          "-l"
        ],
        "summary": "Filter by label",
        "status": "supported"
      },
      {
        "name": "--limit",
        "aliases": [
          "-L"
        ],
        "summary": "Maximum number of issues to fetch",
        "status": "supported"
      },
      {
        "name": "--mention",
        "summary": "Filter by mention",
        "status": "supported"
      },
      {
        "name": "--milestone",
        "aliases": [
          "-m"
        ],
        "summary": "Filter by milestone number or title",
        "status": "supported"
      },
      {
        "name": "--search",
        "aliases": [
          "-S"
        ],
        "summary": "Search issues with query",
        "status": "emulated",
        "reason": "Maps the raw search string to Gitea's repository issue query parameter rather than GitHub's full advanced issue-search syntax."
      },
      {
        "name": "--state",
        "aliases": [
          "-s"
        ],
        "summary": "Filter by state: {open|closed|all}",
        "status": "supported"
      },
      {
        "name": "--web",
        "aliases": [
          "-w"
        ],
        "summary": "List issues in the web browser",
        "status": "unsupported",
        "reason": "Opening filtered issue lists in the browser is not part of the supported issue list slice."
      }
    ],
    "issueViewOptions": [
      {
        "name": "--comments",
        "summary": "Show the full issue conversation",
        "status": "supported"
      }
    ],
    "issueCreateOptions": [
      {
        "name": "--title",
        "aliases": [
          "-t"
        ],
        "summary": "Supply the issue title",
        "status": "supported"
      },
      {
        "name": "--body",
        "aliases": [
          "-b"
        ],
        "summary": "Supply the issue body",
        "status": "supported"
      },
      {
        "name": "--body-file",
        "aliases": [
          "-F"
        ],
        "summary": "Read body text from file (use \"-\" to read from standard input)",
        "status": "supported"
      },
      {
        "name": "--assignee",
        "aliases": [
          "-a"
        ],
        "summary": "Assign people by their login; use \"@me\" to self-assign",
        "status": "emulated",
        "reason": "Applies assignees in an immediate follow-up issue edit after creation."
      },
      {
        "name": "--label",
        "aliases": [
          "-l"
        ],
        "summary": "Add labels by name",
        "status": "emulated",
        "reason": "Applies labels in an immediate follow-up issue edit after creation."
      },
      {
        "name": "--milestone",
        "aliases": [
          "-m"
        ],
        "summary": "Add the issue to a milestone by name",
        "status": "emulated",
        "reason": "Resolves the milestone and applies it in an immediate follow-up issue edit after creation."
      }
    ],
    "prStructuredOutput": [
      {
        "name": "--json",
        "summary": "Format output as JSON",
        "status": "supported"
      },
      {
        "name": "--jq",
        "summary": "Filter JSON output with jq syntax",
        "status": "unsupported",
